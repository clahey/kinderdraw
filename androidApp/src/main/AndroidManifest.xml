<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      @spec CANVAS-UX-051

      No action bar over the drawing surface — see the User Experience LLD's
      Screen Composition.

      Light is what makes the window background white, which is the color the
      canvas itself resolves to today (see DefaultStyleSettings), so nothing
      flashes between the window appearing and Compose's first frame.
    -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
