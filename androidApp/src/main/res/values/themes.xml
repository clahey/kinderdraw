<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      @spec CANVAS-UX-051

      The kid canvas is presented with no chrome of the platform's own — see
      the User Experience LLD's Screen Composition. Only the action bar is
      removable through a theme; hiding the system bars needs the window's
      insets controller, in WindowPresentation.kt.

      The Light parent is what makes the window background white, which is the
      color the canvas itself resolves to today (see DefaultStyleSettings), so
      nothing flashes between the window appearing and Compose's first frame.
    -->
    <style name="Theme.KinderDraw" parent="android:Theme.DeviceDefault.Light.NoActionBar" />
</resources>
