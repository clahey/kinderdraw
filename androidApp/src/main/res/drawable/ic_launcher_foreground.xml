<?xml version="1.0" encoding="utf-8"?>
<!--
  One continuous toddler scribble — see the Publishing LLD's Store Listing Assets.

  The line is authored as two overlapping halves so its colour changes partway.
  Draw order is load-bearing: the green half comes second and therefore passes
  over the blue where the line crosses itself, which is what makes the crossing
  read as one line going over its own path. Reordering these two paths breaks
  the icon.

  Brand light blue, green, and yellow — see docs/brand.md.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M30,60 C24,40 42,26 58,30 C74,34 82,52 70,64"
        android:strokeColor="#47AADC"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M70,64 C58,76 38,72 40,58 C42,46 60,44 70,54 C76,60 78,70 72,78"
        android:strokeColor="#148244"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:fillColor="#FCD214"
        android:pathData="M67.5,78 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0" />
</vector>
