<!--
  One continuous toddler scribble — see the Publishing LLD's Store Listing Assets.

  The line is authored as two overlapping halves so its colour changes partway.
  Draw order is load-bearing: the green half comes second and therefore passes
  over the blue where the line crosses itself, which is what makes the crossing
  read as one line going over its own path. Reordering these two paths breaks
  the icon.
  The colour changes *underneath* that crossing, not at a point in the open, so
  the seam between the two halves is never visible and the green needs no end
  cap to hide it — hence butt at both ends, with the far end under the yellow
  dot. A round or square cap at the seam reaches past the blue it is laid over
  and shows as a rim of light blue.

  The halves meet at 74,58.25 with the control points either side of it —
  79.5,47 and 73.0294,60.2353 — colinear through it, which is what makes them
  read as one continuous curve rather than two that happen to touch. That lone
  unrounded control point is the price of the constraint: move any of those
  three and the other two have to be re-derived, or the line kinks at the seam.

  Brand light blue, green, and yellow — see docs/brand.md.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M30,60 C24,40 42,26 58,30 C71.5,33.5 79.5,47 74,58.25"
        android:strokeColor="#47AADC"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M74,58.25 C73.0294,60.2353 71.75,62.25 70,64 C58,76 38,72 40,58 C42,46 60,44 70,54 C76,60 78,70 72,78"
        android:strokeColor="#148244"
        android:strokeWidth="9"
        android:strokeLineCap="butt"
        android:strokeLineJoin="round" />
    <path
        android:fillColor="#FCD214"
        android:pathData="M67.5,78 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0" />
</vector>
